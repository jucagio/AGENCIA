# Credenciales — NUNCA versionas .env en Git, usa .env.example como template
# Edita .env localmente con valores reales

# Claude API
CLAUDE_API_KEY=sk-ant-...

# GROQ (opcional)
GROQ_API_KEY=gsk_...

# Supabase (BD remota para backup + sync)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# PostgreSQL Local (Docker)
DATABASE_URL=postgresql://agencia:password@localhost:5432/agencia_db
DATABASE_USER=agencia
DATABASE_PASSWORD=your_postgres_password_here

# Redis (Cache local)
REDIS_URL=redis://localhost:6379

# JWT (seguridad APIs)
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_ALGORITHM=HS256

# n8n (automatización)
N8N_EMAIL=your_n8n_email@example.com
N8N_PASSWORD=your_n8n_password_here
N8N_API_URL=https://n8n-production-xxx.up.railway.app
N8N_API_KEY=n8n_api_key_here

# WhatsApp/Webhook
WHATSAPP_WEBHOOK_TOKEN=your_webhook_token_here
WHATSAPP_BUSINESS_ACCOUNT_ID=xxx
WHATSAPP_PHONE_NUMBER_ID=xxx
WHATSAPP_ACCESS_TOKEN=xxx

# Environment
ENVIRONMENT=development
DEBUG=false
