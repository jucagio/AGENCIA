# ===================================================
# MAPER WhatsApp AgentKit — Variables de entorno
# ===================================================
# Copia este archivo como .env y completa los valores.
# NUNCA subas .env a git (ya esta en .gitignore).

# --- Anthropic (obligatorio) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- WhatsApp / Meta Cloud API (obligatorio) ---
# Obtener en: developers.facebook.com > tu App > WhatsApp > Configuration
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Obtener en: developers.facebook.com > tu App > Settings > Basic > App Secret
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tu defines este valor. Minimo 20 caracteres.
# Usarlo tambien en Meta > WhatsApp > Configuration > Webhook > Verify Token
WEBHOOK_VERIFY_TOKEN=maper_ia_whatsapp_meta_2026

# --- Agente (opcional — tienen defaults) ---
AGENT_NAME=MAPER-Vendedor
AGENT_MODEL=claude-opus-4-0
AGENT_FALLBACK_MESSAGE=No entendi tu pregunta. Puedes intentar nuevamente?
AGENT_GREETING=Hola, soy el asistente MAPER. En que te puedo ayudar hoy?

# --- Servidor (opcional) ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Rate limiting (opcional) ---
# Maximo de mensajes por numero de telefono por ventana de tiempo.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Claude API (opcional) ---
CLAUDE_TIMEOUT_SECONDS=30
CLAUDE_MAX_TOKENS=1024
