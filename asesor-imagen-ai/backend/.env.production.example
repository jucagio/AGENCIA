# =============================================================
# .env.production.example — Sprint Fase 1 (Supabase Real)
# =============================================================
# Copia este archivo a `.env` y rellena los 4 valores marcados con <PEGAR_AQUI>.
# Una vez lleno, ejecuta:
#   .\apply_migrations.ps1 -DbUrl "$env:SUPABASE_DB_URL" -SeedTestUsers
#   python verify_supabase_ready.py
#
# DONDE OBTENER CADA VALOR (Supabase Dashboard):
#   Project Settings -> API:
#       - Project URL          -> SUPABASE_URL
#       - anon / public key    -> SUPABASE_ANON_KEY
#       - service_role key     -> SUPABASE_SERVICE_ROLE_KEY   (SECRETO; nunca al frontend)
#   Project Settings -> Database -> Connection string -> URI:
#       - Connection string    -> SUPABASE_DB_URL             (incluye password; SECRETO)
# =============================================================

# -------------------------------------------------------------
# Environment
# -------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://asesor-imagen.com,https://app.asesor-imagen.com

# -------------------------------------------------------------
# Supabase Auth & Database (ADR-001) — REQUERIDOS
# -------------------------------------------------------------
# URL pública del proyecto. Ej: https://abcdefghijklmno.supabase.co
SUPABASE_URL=<PEGAR_AQUI_PROJECT_URL>

# Anon key (JWT firmado, seguro para frontend).
SUPABASE_ANON_KEY=<PEGAR_AQUI_ANON_KEY>

# Service role key (BYPASSEA RLS — nunca al cliente). Solo backend.
SUPABASE_SERVICE_ROLE_KEY=<PEGAR_AQUI_SERVICE_ROLE_KEY>

# Connection string PostgreSQL (incluye password de DB).
# Formato: postgresql://postgres.[REF]:[PASSWORD]@aws-X-region.pooler.supabase.com:6543/postgres
# Usado por apply_migrations.ps1 — NO se carga en runtime del backend.
SUPABASE_DB_URL=<PEGAR_AQUI_CONNECTION_STRING>

# JWT audience (default Supabase). No cambiar a menos que sepas qué haces.
SUPABASE_JWT_AUDIENCE=authenticated

# -------------------------------------------------------------
# Storage buckets (ADR-005) — nombres fijos, ya creados por M002
# -------------------------------------------------------------
SUPABASE_AVATARS_BUCKET=avatars
SUPABASE_WARDROBE_BUCKET=wardrobe
SUPABASE_TRYONS_BUCKET=tryons

# -------------------------------------------------------------
# Redis / ARQ (workers) — REQUERIDOS en producción
# -------------------------------------------------------------
# Upstash recomendado para producción (TLS).
# Formato: rediss://default:[TOKEN]@[HOST].upstash.io:6379
REDIS_URL=<PEGAR_AQUI_REDIS_URL>
ARQ_QUEUE_NAME=asesor_imagen_jobs

# -------------------------------------------------------------
# Feature flags (Sprint 0.5)
# -------------------------------------------------------------
# false = workers reales (Vision + Replicate + Anthropic). Producción debe ser false.
FEATURE_MOCK_WORKERS=false
# true = rate limiting habilitado (slowapi + Redis). Producción debe ser true.
FEATURE_RATE_LIMIT_ENABLED=true
RATE_LIMIT_STRATEGY=fixed-window
RATE_LIMIT_PER_MINUTE=60

# -------------------------------------------------------------
# External AI APIs — REQUERIDOS para producción real
# -------------------------------------------------------------
# Si quedan vacíos y FEATURE_MOCK_WORKERS=false, los workers fallarán al primer job.
REPLICATE_API_TOKEN=<PEGAR_AQUI_REPLICATE_TOKEN>
REPLICATE_MODEL_VERSION=latest_model_version
FASHN_MODEL_VERSION=zs36x4rfa1rmc0cryry84mk6wr
FASHN_PRO_TIMEOUT_SECONDS=15

ANTHROPIC_API_KEY=<PEGAR_AQUI_ANTHROPIC_KEY>
ANTHROPIC_MODEL=claude-opus-4-7

# Path al JSON de credenciales Google Vision (o JSON inline en GOOGLE_VISION_CREDENTIALS_JSON).
GOOGLE_VISION_CREDENTIALS=/secrets/google-vision.json

# -------------------------------------------------------------
# Payments (opcional MVP; requerido para monetización)
# -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# -------------------------------------------------------------
# Legacy JWT (no se usa en ADR-001, mantener por compatibilidad config)
# -------------------------------------------------------------
SECRET_KEY=<GENERAR_32_CHARS_ALEATORIOS>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================
# CHECKLIST POST-LLENADO
# =============================================================
# [ ] SUPABASE_URL pegado (https://*.supabase.co)
# [ ] SUPABASE_ANON_KEY pegado (empieza con eyJ...)
# [ ] SUPABASE_SERVICE_ROLE_KEY pegado (empieza con eyJ..., DIFERENTE del anon)
# [ ] SUPABASE_DB_URL pegado (postgresql://postgres...@...supabase.com:6543/postgres)
# [ ] Validar conexión: psql "$env:SUPABASE_DB_URL" -c "SELECT 1;"
# [ ] Aplicar migraciones: .\apply_migrations.ps1 -DbUrl "$env:SUPABASE_DB_URL" -SeedTestUsers
# [ ] Verificar: python verify_supabase_ready.py
# =============================================================
