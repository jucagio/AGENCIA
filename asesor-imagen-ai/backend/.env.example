# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000
RATE_LIMIT_PER_MINUTE=60

# Supabase Auth & Database (ADR-001)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_AUDIENCE=authenticated

# Storage (ADR-005) - Supabase Storage (3 buckets, MVP)
# Cliente sube directo a Supabase Storage; backend nunca recibe UploadFile.
SUPABASE_AVATARS_BUCKET=avatars
SUPABASE_WARDROBE_BUCKET=wardrobe
SUPABASE_TRYONS_BUCKET=tryons

# Storage (ADR-005) - Cloudflare R2 (CDN futuro, opcional MVP)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=asesor-imagen-bucket
R2_PUBLIC_URL=https://cdn.yourdomain.com

# Async Worker & Idempotency (ADR-002, ADR-003)
# Local dev: redis://localhost:6379/0
# Staging/Prod (Upstash TLS): rediss://default:$UPSTASH_TOKEN@$UPSTASH_HOST.upstash.io:6379
REDIS_URL=redis://localhost:6379/0
ARQ_QUEUE_NAME=asesor_imagen_jobs

# Rate Limiting (Sprint A1 — ADR-007)
# Master switch. When false, the rate_limit decorator is a no-op (safe rollout).
FEATURE_RATE_LIMIT_ENABLED=false
# Algorithm: "fixed-window" (cheap, default) | "sliding-window" (smoother, ~2x ops)
RATE_LIMIT_STRATEGY=fixed-window

# Feature flags (Sprint 0.5 T7)
#   FEATURE_MOCK_WORKERS=true  -> workers return canned responses (PATH A: dev, CI).
#   FEATURE_MOCK_WORKERS=false -> workers call Vision / Replicate / Anthropic (PATH B: prod).
FEATURE_MOCK_WORKERS=false

# FASHN PRO inference timeout in seconds. If exceeded, replicate_worker falls
# back to the STD (balanced) tier.
FASHN_PRO_TIMEOUT_SECONDS=15

# External AI APIs
REPLICATE_API_TOKEN=your_replicate_token
REPLICATE_MODEL_VERSION=latest_model_version

# FASHN tryon model (pinned hash — ADR-004)
# Source: Replicate fashn-ai/tryon — pin by version hash for reproducibility.
FASHN_MODEL_VERSION=zs36x4rfa1rmc0cryry84mk6wr
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_MODEL=claude-opus-4-7
GOOGLE_VISION_CREDENTIALS=/path/to/credentials.json

# Payments
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
MERCADO_PAGO_ACCESS_TOKEN=your_mercado_pago_token
MERCADO_PAGO_WEBHOOK_SECRET=your_mercado_pago_webhook_secret

# Legacy Custom JWT (Removed in Entrega 0.2)
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
