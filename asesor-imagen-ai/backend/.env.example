# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000
RATE_LIMIT_PER_MINUTE=60

# Supabase Auth & Database (ADR-001)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_AUDIENCE=authenticated

# Storage (ADR-005) - Cloudflare R2
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=asesor-imagen-bucket
R2_PUBLIC_URL=https://cdn.yourdomain.com

# Async Worker & Idempotency (ADR-002, ADR-003)
REDIS_URL=redis://localhost:6379/0
ARQ_QUEUE_NAME=asesor_imagen_jobs

# External AI APIs
REPLICATE_API_TOKEN=your_replicate_token
REPLICATE_MODEL_VERSION=latest_model_version
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_MODEL=claude-opus-4-7
GOOGLE_VISION_CREDENTIALS=/path/to/credentials.json

# Payments
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
MERCADO_PAGO_ACCESS_TOKEN=your_mercado_pago_token
MERCADO_PAGO_WEBHOOK_SECRET=your_mercado_pago_webhook_secret

# Legacy Custom JWT (Removed in Entrega 0.2)
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
