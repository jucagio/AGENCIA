# ENVIRONMENT CONFIGURATION
# Copy this to .env and fill in values

# ===== DATABASE =====
DATABASE_URL=postgresql://user:password@localhost:5432/asesor_imagen_dev
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ===== AUTH & SECURITY =====
JWT_SECRET=dev-secret-key-change-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# ===== GOOGLE CLOUD VISION API =====
# Get from: https://console.cloud.google.com
# Service Account -> Keys -> Create JSON key
GOOGLE_CLOUD_VISION_API_KEY={"type": "service_account", "project_id": "...", ...}
# OR store as path:
GOOGLE_CLOUD_VISION_API_KEY_PATH=/path/to/service-account-key.json

# ===== REPLICATE API =====
# Get from: https://replicate.com/account
# Copy API token
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# ===== CLAUDE API (Anthropic) =====
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ===== REDIS (for ARQ job queue) =====
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# ===== STRIPE (Payment) =====
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===== MERCADOPAGO (Payment - LATAM) =====
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token_here
MERCADOPAGO_WEBHOOK_SECRET=your_mp_webhook_secret_here

# ===== SENTRY (Error Tracking) =====
SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_ENVIRONMENT=development

# ===== POSTHOG (Analytics) =====
POSTHOG_API_KEY=phc_your_posthog_key_here
POSTHOG_HOST=https://app.posthog.com

# ===== ENVIRONMENT & DEPLOYMENT =====
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ===== RATE LIMITING (Sprint 0.4) =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60  # Global default
AUTH_RATE_LIMIT_PER_MINUTE=5  # /auth/* endpoints
AI_RATE_LIMIT_PER_HOUR=30  # /api/v1/body-analysis, /api/v1/try-ons, etc.

# ===== WORKER CONFIGURATION =====
VISION_BATCH_SIZE=5
REPLICATE_MODEL_VERSION=latest-tryon-model
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ===== STORAGE =====
STORAGE_BUCKET_NAME=try-ons
STORAGE_SIGNED_URL_EXPIRY_HOURS=24

# ===== CORS & SECURITY =====
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com
CORS_CREDENTIALS=true

# ===== APP BRANDING (from D1-D5 decisions) =====
APP_NAME=AI Fit Check
APP_TAGLINE=Tu Asesor de Imagen Confiable
APP_VERSION=0.5.0

# ===== PRICING (from D4 decision) =====
FREE_TIER_LIMIT=1  # try-ons per day
ESTILO_PRICE_USD=9.99
ESTILO_PRICE_COP=50000
IMAGEN_PRICE_USD=19.99
IMAGEN_PRICE_COP=80000

# ===== FEATURE FLAGS =====
FEATURE_BODY_ANALYSIS=true
FEATURE_SOCIAL_SHARING=true
FEATURE_COLLECTIONS=true
FEATURE_RECOMMENDATIONS=true
FEATURE_MOCK_WORKERS=false  # Set to true for dev/testing without real API calls
