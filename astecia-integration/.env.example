# ============================================
# ASTECIA — Environment Variables
# ============================================

# GOOGLE APIs
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REFRESH_TOKEN=your-refresh-token-here

# Claude API
CLAUDE_API_KEY=sk-ant-your-api-key-here
# Get from: https://console.anthropic.com/

# Security & Configuration
OAUTH_REDIRECT_URL=http://localhost:3000/oauth/callback
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
NODE_ENV=development
PORT=3000

# WhatsApp Web
WHATSAPP_SESSION_NAME=astecia-session

# Optional: Logging & Monitoring
LOG_LEVEL=debug
LOG_FILE=./logs/astecia.log

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Google OAuth:
#    - Go to: https://console.cloud.google.com/apis/credentials
#    - Create OAuth 2.0 Client ID (Desktop app)
#    - Download JSON → copy fields above

# 2. Generate Refresh Token:
#    npm run generate-token

# ============================================
# SECURITY
# ============================================
# ⚠️  NEVER commit this file
# ✅  Use .gitignore to exclude .env from git
# ✅  All secrets are environment-specific
# ✅  Rotate REFRESH_TOKEN if exposed
